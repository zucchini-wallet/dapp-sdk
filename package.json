{
  "name": "@zucchinifi/dapp-sdk",
  "version": "0.2.0",
  "description": "Typed Zcash, EVM, and Solana integration SDK for Zucchini Wallet",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./merchant": {
      "types": "./dist/merchant.d.ts",
      "import": "./dist/merchant.js"
    },
    "./merchant/server": {
      "types": "./dist/merchant-server.d.ts",
      "import": "./dist/merchant-server.js"
    },
    "./zcash": {
      "types": "./dist/zcash.d.ts",
      "import": "./dist/zcash.js"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm check && pnpm test && pnpm verify:package"
  },
  "dependencies": {
    "@solana/wallet-standard-features": "1.4.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "@zucchinifi/merchant-payments": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.19 <23"
  },
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zucchini-wallet/dapp-sdk.git"
  },
  "pnpm": {
    "overrides": {
      "@zucchinifi/merchant-payments": "file:vendor/zucchinifi-merchant-payments-0.1.0-alpha.1-0b69276.tgz"
    }
  },
  "bundledDependencies": [
    "@zucchinifi/merchant-payments"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
